{
  "name": "ai-chatbot-web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"PORT=5050 node server/index.js\" \"npm --prefix client run dev -- --host 0.0.0.0 --port 5173\"",
    "server": "PORT=5050 node server/index.js",
    "client": "npm --prefix client run dev -- --host 0.0.0.0 --port 5173",
    "build": "npm --prefix client run build",
    "start": "NODE_ENV=production PORT=5050 node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
